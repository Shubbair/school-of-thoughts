# Use "ollama" for local models or "api" for an OpenAI
MODEL_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL = http://localhost:11434
OLLAMA_MODEL = beam:cloud

# Optional: use a different model for the facilitator
# CHAIRMAN_MODEL=llama3.2:1b


